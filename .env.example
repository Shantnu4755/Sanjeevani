APP_NAME=sanjeevani
DATABASE_URL=postgresql+psycopg://sanjeevani:change-me@localhost:5432/sanjeevani
LOG_LEVEL=INFO
DEBUG=false
# Docker API through docker-socket-proxy (list and restart only), never the raw socket
DOCKER_URL=tcp://docker-proxy:2375
# Telegram alerts; without them alerts are only logged
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# required for POST /services/<name>/restart; manual restarts are disabled while empty
ADMIN_TOKEN=
# seconds between health check rounds
CHECK_INTERVAL=30
